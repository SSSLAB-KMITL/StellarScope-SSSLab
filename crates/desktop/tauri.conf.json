{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StellarScope-SSSLab",
  "version": "2.0.0",
  "identifier": "org.ssslab.stellarscope",
  "build": {
    "beforeBuildCommand": "npm --prefix ../../ui run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "StellarScope-SSSLab — 2D/3D Satellite Tracking & Earth Observation Simulator",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
